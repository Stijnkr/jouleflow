[Unit]
Description=Jouleflow home energy management system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/backend
Environment=JOULEFLOW_DATA_DIR=/var/lib/jouleflow
Environment=JOULEFLOW_PORT=80
Environment=JOULEFLOW_HTTPS=true
Environment=JOULEFLOW_HTTPS_PORT=443
EnvironmentFile=-/etc/jouleflow.env
ExecStart=@REPO@/backend/.venv/bin/jouleflow
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Keep the database, keys and setup code private to the service user.
UMask=0077
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
