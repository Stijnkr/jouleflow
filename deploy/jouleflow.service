[Unit]
Description=Jouleflow home energy management system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/backend
Environment=JOULEFLOW_DATA_DIR=/var/lib/jouleflow
Environment=JOULEFLOW_PORT=80
EnvironmentFile=-/etc/jouleflow.env
ExecStart=@REPO@/backend/.venv/bin/jouleflow
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
